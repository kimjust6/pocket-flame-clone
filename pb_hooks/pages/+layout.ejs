<!doctype html>
<html lang="en" data-theme="yellowdark" x-data="shell()">
    <head>
        <%- include('head.ejs') %> <%- include('theme-init.ejs') %> <%-
        include('alpine-setup.ejs') %> <%- include('shell-init.ejs') %> <%-
        include('custom-styles.ejs') %>
    </head>
    <%
        const customBg = (locals.settings && locals.settings.color_background && locals.settings.color_background !== '#282525') ? locals.settings.color_background : '';
        const customPrimary = (locals.settings && locals.settings.color_primary && locals.settings.color_primary !== '#d9d9d9') ? locals.settings.color_primary : '';
        const customAccent = (locals.settings && locals.settings.color_accent && locals.settings.color_accent !== '#50fbc2') ? locals.settings.color_accent : '';
        const customStyles = [
            customBg ? `--custom-color-background: ${customBg};` : '',
            customPrimary ? `--custom-color-primary: ${customPrimary};` : '',
            customAccent ? `--custom-color-accent: ${customAccent};` : ''
        ].filter(Boolean).join('');
    %>
    <body
        style="<%= customStyles %>"
        class="min-h-screen"
    >
        <div class="relative flex min-h-screen flex-col">
            <div x-on:click.outside="navOpen = false">
                <%- include('header.ejs') %> <%- include('mobile-menu.ejs') %>
            </div>

            <main
                class="relative flex-grow transition-all duration-200"
                :style="{ 'padding-top': headerVisible ? '3.3rem' : '0' }"
            >
                <%- slot %>
            </main>

            <% if (!locals.data || (!locals.data.isHome && !locals.data.list)) {
            %> <%- include('footer.ejs') %> <% } %>
        </div>
        <%- include('link-fixer.ejs') %>
    </body>
</html>
