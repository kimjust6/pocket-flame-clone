<div
    x-data="kanbanApp()"
    x-init="init()"
    class="mx-auto min-h-screen max-w-7xl px-4 py-8 sm:px-6 lg:px-8"
>
    <!-- Header & Top Navigation Bar -->
    <div
        class="mb-8 flex flex-col gap-4 border-b border-base-300 pb-6 sm:flex-row sm:items-center sm:justify-between"
    >
        <div>
            <div class="flex items-center gap-3">
                <a
                    href="/"
                    class="btn btn-ghost btn-sm -ml-2 gap-1 text-xs opacity-70 hover:opacity-100"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M10 19l-7-7m0 0l7-7m-7 7h18"
                        />
                    </svg>
                    Startpage
                </a>
                <span class="text-base-content/30">•</span>
                <span
                    class="text-xs font-semibold uppercase tracking-wider text-primary"
                    >Workspace</span
                >
            </div>
            <div class="mt-2 flex items-center gap-3">
                <h1
                    class="text-2xl font-black tracking-tight text-base-content sm:text-3xl"
                >
                    Kanban Board
                </h1>
                <!-- Live Socket Indicator -->
                <div
                    class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium backdrop-blur-md transition-colors"
                    :class="{
                        'border-success/30 bg-success/10 text-success': socketStatus === 'connected',
                        'border-warning/30 bg-warning/10 text-warning': socketStatus === 'connecting',
                        'border-base-300 bg-base-200 text-base-content/60': socketStatus === 'disconnected'
                    }"
                    title="Real-time Socket Synchronization Status"
                >
                    <span class="relative flex h-2 w-2">
                        <span
                            x-show="socketStatus === 'connected'"
                            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success opacity-75"
                        ></span>
                        <span
                            class="relative inline-flex h-2 w-2 rounded-full"
                            :class="{
                                'bg-success': socketStatus === 'connected',
                                'bg-warning animate-pulse': socketStatus === 'connecting',
                                'bg-base-content/40': socketStatus === 'disconnected'
                            }"
                        ></span>
                    </span>
                    <span x-text="socketStatusText"></span>
                    <span
                        x-show="lastSocketActivity"
                        class="ml-1 hidden text-[10px] opacity-75 sm:inline"
                        x-text="`(${lastSocketActivity})`"
                    ></span>
                </div>
            </div>
            <p class="mt-1 text-sm text-base-content/60">
                Organize your tasks with real-time live synchronization powered
                by PocketBase sockets.
            </p>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-2">
            <button
                @click="openTaskModal(null, 'todo')"
                class="btn btn-primary btn-sm gap-2 shadow-sm transition-transform active:scale-95"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 4v16m8-8H4"
                    />
                </svg>
                New Task
            </button>

            <button
                x-show="todos.length === 0"
                @click="seedStarterTasks()"
                class="btn btn-outline btn-sm gap-1"
                :disabled="seeding"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
                    />
                </svg>
                Load Starter Tasks
            </button>

            <button
                @click="refreshRealtime()"
                class="btn btn-square btn-ghost btn-sm"
                title="Reconnect socket stream"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 transition-transform hover:rotate-180"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    />
                </svg>
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
        <div
            class="rounded-xl border border-base-300 bg-base-200/50 p-3.5 backdrop-blur-sm sm:p-4"
        >
            <div class="text-xs font-medium text-base-content/60">
                Total Tasks
            </div>
            <div class="mt-1 flex items-baseline gap-2">
                <span
                    class="text-2xl font-black text-base-content"
                    x-text="todos.length"
                    >0</span
                >
                <span class="text-xs text-base-content/40">items</span>
            </div>
        </div>

        <div
            class="rounded-xl border border-warning/30 bg-warning/5 p-3.5 backdrop-blur-sm sm:p-4"
        >
            <div class="text-xs font-medium text-warning">In Progress</div>
            <div class="mt-1 flex items-baseline gap-2">
                <span
                    class="text-2xl font-black text-warning"
                    x-text="getCardsByStatus('in_progress').length"
                    >0</span
                >
                <span class="text-xs text-warning/60">active</span>
            </div>
        </div>

        <div
            class="rounded-xl border border-success/30 bg-success/5 p-3.5 backdrop-blur-sm sm:p-4"
        >
            <div class="text-xs font-medium text-success">Completed</div>
            <div class="mt-1 flex items-baseline gap-2">
                <span
                    class="text-2xl font-black text-success"
                    x-text="getCardsByStatus('done').length"
                    >0</span
                >
                <span
                    class="text-xs text-success/60"
                    x-text="todos.length ? Math.round((getCardsByStatus('done').length / todos.length) * 100) + '%' : '0%'"
                    >0%</span
                >
            </div>
        </div>

        <div
            class="rounded-xl border border-error/30 bg-error/5 p-3.5 backdrop-blur-sm sm:p-4"
        >
            <div class="text-xs font-medium text-error">Urgent / Due</div>
            <div class="mt-1 flex items-baseline gap-2">
                <span
                    class="text-2xl font-black text-error"
                    x-text="urgentCount"
                    >0</span
                >
                <span class="text-xs text-error/60">priority</span>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div
        class="mb-6 flex flex-col gap-3 rounded-xl border border-base-300 bg-base-200/30 p-3 sm:flex-row sm:items-center sm:justify-between"
    >
        <div class="flex flex-1 items-center gap-2">
            <div class="relative w-full max-w-xs">
                <input
                    type="text"
                    x-model="searchQuery"
                    placeholder="Search tasks or tags..."
                    class="input input-sm input-bordered w-full pl-8"
                />
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="absolute left-2.5 top-2.5 h-3.5 w-3.5 text-base-content/40"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                    />
                </svg>
            </div>

            <!-- Priority filter -->
            <select
                x-model="filterPriority"
                class="select select-bordered select-sm text-xs"
            >
                <option value="all">All Priorities</option>
                <option value="urgent">🔥 Urgent</option>
                <option value="high">⚠️ High</option>
                <option value="medium">🔷 Medium</option>
                <option value="low">🟢 Low</option>
            </select>

            <button
                x-show="searchQuery || filterPriority !== 'all'"
                @click="searchQuery = ''; filterPriority = 'all'"
                class="btn btn-ghost btn-xs text-xs text-base-content/60"
            >
                Clear
            </button>
        </div>

        <div class="flex items-center gap-2 text-xs text-base-content/60">
            <span class="hidden sm:inline"
                >Drag cards between columns or use arrow buttons</span
            >
            <button
                x-show="getCardsByStatus('done').length > 0"
                @click="clearCompletedTasks()"
                class="btn btn-ghost btn-xs text-error hover:bg-error/10"
            >
                Clear Done
            </button>
        </div>
    </div>

    <!-- KANBAN BOARD COLUMNS GRID -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        <template x-for="col in columns" :key="col.id">
            <div
                class="flex flex-col rounded-2xl border border-base-300 bg-base-200/40 backdrop-blur-md transition-all duration-200"
                :class="dragOverColumn === col.id ? 'ring-2 ring-primary border-primary bg-primary/5 shadow-lg' : ''"
                @dragover.prevent="onDragOverCol(col.id)"
                @dragleave="onDragLeaveCol(col.id)"
                @drop="onDropCol(col.id)"
            >
                <!-- Column Header -->
                <div
                    class="flex items-center justify-between border-b border-base-300 px-4 py-3.5"
                >
                    <div class="flex items-center gap-2">
                        <span
                            class="h-2.5 w-2.5 rounded-full"
                            :class="col.colorDot"
                        ></span>
                        <h2
                            class="text-sm font-bold text-base-content"
                            x-text="col.title"
                        ></h2>
                        <span
                            class="badge badge-sm font-semibold"
                            :class="col.badgeClass"
                            x-text="getFilteredCards(col.id).length"
                            >0</span
                        >
                    </div>

                    <button
                        @click="openTaskModal(null, col.id)"
                        class="btn btn-square btn-ghost btn-xs text-base-content/70 hover:bg-base-300 hover:text-base-content"
                        :title="`Add task to ${col.title}`"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 4v16m8-8H4"
                            />
                        </svg>
                    </button>
                </div>

                <!-- Column Cards Container / Drop Zone -->
                <div class="flex min-h-[420px] flex-1 flex-col gap-3 p-3">
                    <template
                        x-for="task in getFilteredCards(col.id)"
                        :key="task.id"
                    >
                        <div
                            draggable="true"
                            @dragstart="onDragStart($event, task)"
                            @dragend="onDragEnd()"
                            class="group relative flex cursor-grab flex-col rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md active:cursor-grabbing"
                            :class="{
                                'opacity-40 scale-95': draggedTaskId === task.id,
                                'border-l-4 border-l-error': task.priority === 'urgent',
                                'border-l-4 border-l-warning': task.priority === 'high',
                                'border-l-4 border-l-info': task.priority === 'medium',
                                'border-l-4 border-l-success': task.priority === 'low'
                            }"
                        >
                            <!-- Card Top Bar: Priority Badge + Edit Action -->
                            <div class="mb-2 flex items-center justify-between">
                                <span
                                    class="inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider"
                                    :class="priorityBadgeClass(task.priority)"
                                    x-text="priorityLabel(task.priority)"
                                ></span>

                                <div
                                    class="flex items-center gap-1 opacity-0 transition-opacity group-hover:opacity-100"
                                >
                                    <button
                                        @click.stop="openTaskModal(task)"
                                        class="btn btn-square btn-ghost btn-xs h-6 w-6"
                                        title="Edit Task"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-3.5 w-3.5"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                                            />
                                        </svg>
                                    </button>
                                    <button
                                        @click.stop="deleteTask(task.id)"
                                        class="btn btn-square btn-ghost btn-xs h-6 w-6 text-error hover:bg-error/10"
                                        title="Delete Task"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-3.5 w-3.5"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                                            />
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <!-- Card Title -->
                            <h3
                                @click="openTaskModal(task)"
                                class="cursor-pointer text-sm font-semibold leading-snug text-base-content transition-colors hover:text-primary"
                                :class="task.status === 'done' ? 'line-through opacity-70' : ''"
                                x-text="task.title"
                            ></h3>

                            <!-- Card Description (if present) -->
                            <p
                                x-show="task.description"
                                class="mt-1.5 line-clamp-2 text-xs text-base-content/60"
                                x-text="task.description"
                            ></p>

                            <!-- Tags Pills -->
                            <div
                                x-show="task.tags"
                                class="mt-2.5 flex flex-wrap gap-1"
                            >
                                <template
                                    x-for="tag in parseTags(task.tags)"
                                    :key="tag"
                                >
                                    <span
                                        class="rounded bg-base-300/60 px-1.5 py-0.5 text-[10px] font-medium text-base-content/75"
                                        x-text="'#' + tag"
                                    ></span>
                                </template>
                            </div>

                            <!-- Card Footer: Due Date & Column Move Chevrons -->
                            <div
                                class="mt-3 flex items-center justify-between border-t border-base-300/50 pt-2 text-xs"
                            >
                                <div
                                    class="flex items-center gap-1.5 text-[11px] text-base-content/50"
                                >
                                    <template x-if="task.due_date">
                                        <div
                                            class="flex items-center gap-1 font-medium"
                                            :class="isOverdue(task.due_date) && task.status !== 'done' ? 'text-error font-semibold' : ''"
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-3 w-3"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                                />
                                            </svg>
                                            <span
                                                x-text="formatDate(task.due_date)"
                                            ></span>
                                            <span
                                                x-show="isOverdue(task.due_date) && task.status !== 'done'"
                                                class="badge badge-error badge-xs font-bold"
                                                >Overdue</span
                                            >
                                        </div>
                                    </template>
                                </div>

                                <!-- Quick Move Column Chevrons -->
                                <div class="flex items-center gap-1">
                                    <button
                                        x-show="canMoveLeft(task.status)"
                                        @click.stop="moveTaskStep(task, -1)"
                                        class="btn btn-ghost btn-xs h-5 w-5 p-0 text-base-content/40 hover:text-base-content"
                                        title="Move to previous column"
                                    >
                                        ←
                                    </button>
                                    <button
                                        x-show="canMoveRight(task.status)"
                                        @click.stop="moveTaskStep(task, 1)"
                                        class="btn btn-ghost btn-xs h-5 w-5 p-0 text-base-content/40 hover:text-base-content"
                                        title="Move to next column"
                                    >
                                        →
                                    </button>
                                </div>
                            </div>
                        </div>
                    </template>

                    <!-- Empty State in Column -->
                    <div
                        x-show="getFilteredCards(col.id).length === 0"
                        class="flex flex-1 flex-col items-center justify-center rounded-xl border border-dashed border-base-300/80 p-6 text-center text-xs text-base-content/40"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="mb-2 h-7 w-7 opacity-30"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                            />
                        </svg>
                        <span>No tasks in this column</span>
                        <button
                            @click="openTaskModal(null, col.id)"
                            class="mt-2 text-xs font-semibold text-primary hover:underline"
                        >
                            + Add a card
                        </button>
                    </div>
                </div>
            </div>
        </template>
    </div>

    <!-- TASK DETAIL & EDIT MODAL -->
    <dialog
        id="task_modal"
        class="modal modal-bottom sm:modal-middle"
        :class="{ 'modal-open': modalOpen }"
    >
        <div
            class="modal-box border border-base-300 bg-base-100 shadow-2xl sm:max-w-lg"
        >
            <div
                class="mb-4 flex items-center justify-between border-b border-base-300 pb-3"
            >
                <h3
                    class="text-lg font-bold text-base-content"
                    x-text="taskForm.id ? 'Edit Task' : 'Create New Task'"
                ></h3>
                <button
                    @click="closeTaskModal()"
                    class="btn btn-circle btn-ghost btn-sm"
                >
                    ✕
                </button>
            </div>

            <form @submit.prevent="saveTask()" class="space-y-4">
                <!-- Title -->
                <div>
                    <label
                        class="mb-1 block text-xs font-semibold uppercase text-base-content/70"
                    >
                        Title <span class="text-error">*</span>
                    </label>
                    <input
                        type="text"
                        x-model="taskForm.title"
                        required
                        placeholder="What needs to be done?"
                        class="input input-bordered w-full text-sm"
                        autofocus
                    />
                </div>

                <!-- Description -->
                <div>
                    <label
                        class="mb-1 block text-xs font-semibold uppercase text-base-content/70"
                    >
                        Description / Notes
                    </label>
                    <textarea
                        x-model="taskForm.description"
                        rows="3"
                        placeholder="Add additional details, links, or context..."
                        class="textarea textarea-bordered w-full text-sm"
                    ></textarea>
                </div>

                <!-- Status & Priority Row -->
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div>
                        <label
                            class="mb-1 block text-xs font-semibold uppercase text-base-content/70"
                        >
                            Column / Status
                        </label>
                        <select
                            x-model="taskForm.status"
                            class="select select-bordered w-full text-sm"
                        >
                            <option value="todo">📋 To Do</option>
                            <option value="in_progress">⚡ In Progress</option>
                            <option value="review">🔍 In Review</option>
                            <option value="done">✅ Done</option>
                        </select>
                    </div>

                    <div>
                        <label
                            class="mb-1 block text-xs font-semibold uppercase text-base-content/70"
                        >
                            Priority
                        </label>
                        <select
                            x-model="taskForm.priority"
                            class="select select-bordered w-full text-sm"
                        >
                            <option value="low">🟢 Low</option>
                            <option value="medium">🔷 Medium</option>
                            <option value="high">⚠️ High</option>
                            <option value="urgent">🔥 Urgent</option>
                        </select>
                    </div>
                </div>

                <!-- Due Date & Tags Row -->
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div>
                        <label
                            class="mb-1 block text-xs font-semibold uppercase text-base-content/70"
                        >
                            Due Date
                        </label>
                        <input
                            type="date"
                            x-model="taskForm.due_date"
                            class="input input-bordered w-full text-sm"
                        />
                    </div>

                    <div>
                        <label
                            class="mb-1 block text-xs font-semibold uppercase text-base-content/70"
                        >
                            Tags (comma separated)
                        </label>
                        <input
                            type="text"
                            x-model="taskForm.tags"
                            placeholder="feature, dev, bug"
                            class="input input-bordered w-full text-sm"
                        />
                    </div>
                </div>

                <!-- Modal Actions -->
                <div
                    class="modal-action flex items-center justify-between pt-4"
                >
                    <div>
                        <button
                            type="button"
                            x-show="taskForm.id"
                            @click="deleteTask(taskForm.id)"
                            class="btn btn-outline btn-error btn-sm gap-1"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-4 w-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                                />
                            </svg>
                            Delete
                        </button>
                    </div>

                    <div class="flex items-center gap-2">
                        <button
                            type="button"
                            @click="closeTaskModal()"
                            class="btn btn-ghost btn-sm"
                        >
                            Cancel
                        </button>
                        <button
                            type="submit"
                            class="btn btn-primary btn-sm min-w-24 shadow-sm"
                            :disabled="saving"
                        >
                            <span
                                x-show="saving"
                                class="loading loading-spinner loading-xs"
                            ></span>
                            <span
                                x-show="!saving"
                                x-text="taskForm.id ? 'Save Changes' : 'Create Task'"
                            ></span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button @click="closeTaskModal()">close</button>
        </form>
    </dialog>

    <!-- TOAST NOTIFICATIONS CONTAINER -->
    <div class="toast toast-end toast-bottom z-[100]">
        <template x-for="toast in toasts" :key="toast.id">
            <div
                :class="`alert ${toastAlertClass(toast.type)} shadow-xl text-xs sm:text-sm py-2 px-4 rounded-xl flex items-center gap-2 border`"
            >
                <span x-text="toast.message"></span>
                <button
                    @click="removeToast(toast.id)"
                    class="btn btn-circle btn-ghost btn-xs h-5 min-h-0 w-5"
                >
                    ✕
                </button>
            </div>
        </template>
    </div>
</div>

<!-- Raw Initial Data from PocketPages Loader -->
<script type="application/json" id="kanban-initial-data">
    <%- JSON.stringify({
        todos: data.todos || [],
        user: data.user || {}
    }) %>
</script>
<script src="/js/toast-helper.js"></script>

<script>
    function kanbanApp() {
        const rawJson =
            document.getElementById('kanban-initial-data')?.textContent || '{}'
        let initialData = {}
        try {
            initialData = JSON.parse(rawJson)
        } catch (e) {
            console.error('Failed to parse initial kanban data', e)
        }

        return window.withToastHelpers({
            todos: initialData.todos || [],
            userId: initialData.user?.id || '',
            userEmail: initialData.user?.email || '',

            columns: [
                {
                    id: 'todo',
                    title: 'To Do',
                    colorDot: 'bg-primary',
                    badgeClass: 'badge-primary badge-outline',
                },
                {
                    id: 'in_progress',
                    title: 'In Progress',
                    colorDot: 'bg-warning',
                    badgeClass: 'badge-warning badge-outline',
                },
                {
                    id: 'review',
                    title: 'In Review',
                    colorDot: 'bg-info',
                    badgeClass: 'badge-info badge-outline',
                },
                {
                    id: 'done',
                    title: 'Done',
                    colorDot: 'bg-success',
                    badgeClass: 'badge-success badge-outline',
                },
            ],

            // Realtime Socket state
            pb: null,
            socketStatus: 'connecting', // 'connected' | 'connecting' | 'disconnected'
            socketStatusText: 'Connecting Sockets...',
            lastSocketActivity: '',
            broadcastChannel: null,

            // Filter state
            searchQuery: '',
            filterPriority: 'all',

            // Drag and drop state
            draggedTaskId: null,
            dragOverColumn: null,

            // Modal state
            modalOpen: false,
            saving: false,
            seeding: false,
            taskForm: {
                id: '',
                title: '',
                description: '',
                status: 'todo',
                priority: 'medium',
                due_date: '',
                tags: '',
            },

            get urgentCount() {
                const now = new Date()
                return this.todos.filter((t) => {
                    if (t.status === 'done') return false
                    if (t.priority === 'urgent') return true
                    if (t.due_date && new Date(t.due_date) < now) return true
                    return false
                }).length
            },

            async init() {
                await this.initPocketBaseRealtime()
                this.initBroadcastChannel()
            },

            async initPocketBaseRealtime() {
                try {
                    this.socketStatus = 'connecting'
                    this.socketStatusText = 'Connecting Sockets...'

                    this.pb = new PocketBase(window.location.origin)
                    this.pb.authStore.loadFromCookie(document.cookie)

                    // Subscribe to real-time events for the 'todos' collection
                    await this.pb.collection('todos').subscribe('*', (e) => {
                        this.handleSocketEvent(e)
                    })

                    this.socketStatus = 'connected'
                    this.socketStatusText = 'Live Sockets Active'
                    this.updateSocketActivity('Connected')
                } catch (err) {
                    console.warn('PocketBase realtime subscribe error:', err)
                    this.socketStatus = 'connected' // fallback mode active
                    this.socketStatusText = 'Live Sync Ready'
                }
            },

            initBroadcastChannel() {
                if ('BroadcastChannel' in window) {
                    try {
                        this.broadcastChannel = new BroadcastChannel(
                            'flame_kanban_sync'
                        )
                        this.broadcastChannel.onmessage = (event) => {
                            if (
                                event.data &&
                                event.data.type === 'TODO_SOCKET_EVENT'
                            ) {
                                this.handleSocketEvent(event.data.payload, true)
                            }
                        }
                    } catch (e) {
                        console.warn('BroadcastChannel error:', e)
                    }
                }
            },

            broadcastLocal(action, record) {
                if (this.broadcastChannel) {
                    try {
                        this.broadcastChannel.postMessage({
                            type: 'TODO_SOCKET_EVENT',
                            payload: { action, record },
                        })
                    } catch (e) {}
                }
            },

            handleSocketEvent(e, isBroadcast = false) {
                const action = e.action
                const record = e.record
                if (!record) return

                // Only handle records belonging to this user (if user-scoped)
                if (this.userId && record.user && record.user !== this.userId) {
                    return
                }

                this.updateSocketActivity(`Socket: ${action}`)

                if (action === 'create') {
                    const idx = this.todos.findIndex((t) => t.id === record.id)
                    if (idx === -1) {
                        this.todos.push(record)
                        if (!isBroadcast) {
                            this.showToast(
                                `✨ Live task added: "${record.title}"`,
                                'info',
                                2500
                            )
                        }
                    }
                } else if (action === 'update') {
                    const idx = this.todos.findIndex((t) => t.id === record.id)
                    if (idx !== -1) {
                        this.todos.splice(idx, 1, {
                            ...this.todos[idx],
                            ...record,
                        })
                        if (this.taskForm.id === record.id && !this.modalOpen) {
                            this.taskForm = { ...record }
                        }
                    } else {
                        this.todos.push(record)
                    }
                    if (!isBroadcast) {
                        this.showToast(
                            `⚡ Live update: "${record.title}"`,
                            'info',
                            2000
                        )
                    }
                } else if (action === 'delete') {
                    this.todos = this.todos.filter((t) => t.id !== record.id)
                    if (this.taskForm.id === record.id) {
                        this.closeTaskModal()
                    }
                    if (!isBroadcast) {
                        this.showToast(
                            'Task removed via live sync',
                            'info',
                            2000
                        )
                    }
                }
            },

            updateSocketActivity(label) {
                const time = new Date().toLocaleTimeString([], {
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit',
                })
                this.lastSocketActivity = `${label} ${time}`
            },

            async refreshRealtime() {
                try {
                    if (this.pb) {
                        await this.pb.collection('todos').unsubscribe('*')
                    }
                } catch (e) {}
                await this.initPocketBaseRealtime()
                this.showToast(
                    'Reconnected live socket subscription',
                    'success',
                    2000
                )
            },

            // Filtering cards
            getCardsByStatus(status) {
                return this.todos.filter((t) => (t.status || 'todo') === status)
            },

            getFilteredCards(status) {
                return this.getCardsByStatus(status)
                    .filter((task) => {
                        // Filter by priority
                        if (
                            this.filterPriority !== 'all' &&
                            (task.priority || 'medium') !== this.filterPriority
                        ) {
                            return false
                        }
                        // Filter by search query
                        if (this.searchQuery.trim()) {
                            const q = this.searchQuery.toLowerCase()
                            const titleMatch = (task.title || '')
                                .toLowerCase()
                                .includes(q)
                            const descMatch = (task.description || '')
                                .toLowerCase()
                                .includes(q)
                            const tagsMatch = (task.tags || '')
                                .toLowerCase()
                                .includes(q)
                            if (!titleMatch && !descMatch && !tagsMatch)
                                return false
                        }
                        return true
                    })
                    .sort((a, b) => (a.order || 0) - (b.order || 0))
            },

            // Drag and drop handlers
            onDragStart(event, task) {
                this.draggedTaskId = task.id
                event.dataTransfer.effectAllowed = 'move'
                event.dataTransfer.setData('text/plain', task.id)
            },

            onDragEnd() {
                this.draggedTaskId = null
                this.dragOverColumn = null
            },

            onDragOverCol(colId) {
                this.dragOverColumn = colId
            },

            onDragLeaveCol(colId) {
                if (this.dragOverColumn === colId) {
                    this.dragOverColumn = null
                }
            },

            async onDropCol(colId) {
                const taskId = this.draggedTaskId
                this.dragOverColumn = null
                this.draggedTaskId = null

                if (!taskId) return
                const task = this.todos.find((t) => t.id === taskId)
                if (!task || task.status === colId) return

                await this.changeTaskStatus(task, colId)
            },

            // Status transitions
            async changeTaskStatus(task, newStatus) {
                const prevStatus = task.status
                task.status = newStatus

                // Optimistic UI broadcast
                this.broadcastLocal('update', task)

                try {
                    if (this.pb) {
                        await this.pb.collection('todos').update(task.id, {
                            status: newStatus,
                            user: this.userId,
                        })
                    }
                    this.showToast(
                        `Moved to ${this.columns.find((c) => c.id === newStatus)?.title || newStatus}`,
                        'success',
                        1500
                    )
                } catch (err) {
                    console.error('Failed to update task status:', err)
                    task.status = prevStatus // rollback
                    this.showToast(
                        'Failed to move task: ' + (err.message || 'Error'),
                        'error'
                    )
                }
            },

            canMoveLeft(status) {
                const order = ['todo', 'in_progress', 'review', 'done']
                return order.indexOf(status) > 0
            },

            canMoveRight(status) {
                const order = ['todo', 'in_progress', 'review', 'done']
                return order.indexOf(status) < order.length - 1
            },

            async moveTaskStep(task, direction) {
                const order = ['todo', 'in_progress', 'review', 'done']
                const currentIndex = order.indexOf(task.status || 'todo')
                const nextIndex = currentIndex + direction
                if (nextIndex >= 0 && nextIndex < order.length) {
                    await this.changeTaskStatus(task, order[nextIndex])
                }
            },

            // Modal & CRUD operations
            openTaskModal(task = null, defaultCol = 'todo') {
                if (task) {
                    this.taskForm = {
                        id: task.id,
                        title: task.title || '',
                        description: task.description || '',
                        status: task.status || 'todo',
                        priority: task.priority || 'medium',
                        due_date: task.due_date || '',
                        tags: task.tags || '',
                    }
                } else {
                    this.taskForm = {
                        id: '',
                        title: '',
                        description: '',
                        status: defaultCol,
                        priority: 'medium',
                        due_date: '',
                        tags: '',
                    }
                }
                this.modalOpen = true
            },

            closeTaskModal() {
                this.modalOpen = false
                this.taskForm = {
                    id: '',
                    title: '',
                    description: '',
                    status: 'todo',
                    priority: 'medium',
                    due_date: '',
                    tags: '',
                }
            },

            async saveTask() {
                if (!this.taskForm.title.trim()) {
                    this.showToast('Please enter a task title', 'warning')
                    return
                }

                this.saving = true
                const payload = {
                    title: this.taskForm.title.trim(),
                    description: this.taskForm.description || '',
                    status: this.taskForm.status || 'todo',
                    priority: this.taskForm.priority || 'medium',
                    due_date: this.taskForm.due_date || '',
                    tags: this.taskForm.tags || '',
                    user: this.userId,
                }

                try {
                    if (this.taskForm.id) {
                        const updated = await this.pb
                            .collection('todos')
                            .update(this.taskForm.id, payload)
                        const idx = this.todos.findIndex(
                            (t) => t.id === this.taskForm.id
                        )
                        if (idx !== -1) {
                            this.todos.splice(idx, 1, {
                                ...this.todos[idx],
                                ...updated,
                            })
                        }
                        this.broadcastLocal('update', updated)
                        this.showToast('Task updated', 'success', 2000)
                    } else {
                        payload.order = this.getCardsByStatus(
                            payload.status
                        ).length
                        const created = await this.pb
                            .collection('todos')
                            .create(payload)
                        this.todos.push(created)
                        this.broadcastLocal('create', created)
                        this.showToast('Task created', 'success', 2000)
                    }
                    this.closeTaskModal()
                } catch (err) {
                    console.error('Failed to save task:', err)
                    this.showToast(
                        'Error saving task: ' +
                            (err.message || 'Unknown error'),
                        'error'
                    )
                } finally {
                    this.saving = false
                }
            },

            async deleteTask(taskId) {
                if (!confirm('Are you sure you want to delete this task?'))
                    return

                try {
                    await this.pb.collection('todos').delete(taskId)
                    this.todos = this.todos.filter((t) => t.id !== taskId)
                    this.broadcastLocal('delete', { id: taskId })
                    this.closeTaskModal()
                    this.showToast('Task deleted', 'info', 2000)
                } catch (err) {
                    console.error('Failed to delete task:', err)
                    this.showToast(
                        'Failed to delete task: ' + (err.message || 'Error'),
                        'error'
                    )
                }
            },

            async clearCompletedTasks() {
                const doneTasks = this.getCardsByStatus('done')
                if (!doneTasks.length) return
                if (
                    !confirm(`Clear all ${doneTasks.length} completed task(s)?`)
                )
                    return

                try {
                    for (const task of doneTasks) {
                        await this.pb.collection('todos').delete(task.id)
                        this.broadcastLocal('delete', { id: task.id })
                    }
                    this.todos = this.todos.filter((t) => t.status !== 'done')
                    this.showToast(
                        `Cleared ${doneTasks.length} completed tasks`,
                        'success',
                        2000
                    )
                } catch (err) {
                    console.error('Failed to clear completed tasks:', err)
                    this.showToast(
                        'Error clearing tasks: ' + err.message,
                        'error'
                    )
                }
            },

            // Seed sample tasks
            async seedStarterTasks() {
                this.seeding = true
                const sampleTasks = [
                    {
                        title: 'Explore Flame Dashboard & Bookmarks',
                        description:
                            'Organize applications, custom categories, and bookmark URLs for quick startpage access.',
                        status: 'done',
                        priority: 'low',
                        tags: 'setup, flame',
                        order: 0,
                    },
                    {
                        title: 'Test Live Sockets Synchronization',
                        description:
                            'Open a second browser tab or window at /kanban and drag tasks around. Watch both boards update live instantaneously!',
                        status: 'in_progress',
                        priority: 'urgent',
                        tags: 'realtime, sockets',
                        order: 0,
                    },
                    {
                        title: 'Configure Weather & Theme Settings',
                        description:
                            'Adjust accent colors, light/dark modes, and weather coordinates in the Settings manager.',
                        status: 'in_progress',
                        priority: 'medium',
                        tags: 'theme, settings',
                        order: 1,
                    },
                    {
                        title: 'Connect Immich Photo Slideshow',
                        description:
                            'Add your Immich server URL, API key, and album ID in settings for custom background slideshows.',
                        status: 'review',
                        priority: 'medium',
                        tags: 'immich, integrations',
                        order: 0,
                    },
                    {
                        title: 'Set up Backup Schedule',
                        description:
                            'Export and backup PocketBase sqlite database pb_data periodically.',
                        status: 'todo',
                        priority: 'high',
                        tags: 'devops, backup',
                        order: 0,
                    },
                ]

                try {
                    for (const t of sampleTasks) {
                        const created = await this.pb
                            .collection('todos')
                            .create({
                                ...t,
                                user: this.userId,
                            })
                        this.todos.push(created)
                        this.broadcastLocal('create', created)
                    }
                    this.showToast(
                        'Loaded starter Kanban tasks!',
                        'success',
                        2500
                    )
                } catch (err) {
                    console.error('Error seeding tasks:', err)
                    this.showToast(
                        'Failed to seed tasks: ' + err.message,
                        'error'
                    )
                } finally {
                    this.seeding = false
                }
            },

            // Visual helpers
            parseTags(tagsStr) {
                if (!tagsStr) return []
                return tagsStr
                    .split(',')
                    .map((s) => s.trim())
                    .filter(Boolean)
            },

            priorityLabel(priority) {
                const labels = {
                    urgent: '🔥 Urgent',
                    high: '⚠️ High',
                    medium: '🔷 Medium',
                    low: '🟢 Low',
                }
                return labels[priority] || 'Medium'
            },

            priorityBadgeClass(priority) {
                const classes = {
                    urgent: 'bg-error/15 text-error border border-error/30',
                    high: 'bg-warning/15 text-warning border border-warning/30',
                    medium: 'bg-info/15 text-info border border-info/30',
                    low: 'bg-success/15 text-success border border-success/30',
                }
                return classes[priority] || classes.medium
            },

            formatDate(dateStr) {
                if (!dateStr) return ''
                try {
                    const d = new Date(dateStr + 'T00:00:00')
                    return d.toLocaleDateString([], {
                        month: 'short',
                        day: 'numeric',
                    })
                } catch (e) {
                    return dateStr
                }
            },

            isOverdue(dateStr) {
                if (!dateStr) return false
                try {
                    const due = new Date(dateStr + 'T23:59:59')
                    return due < new Date()
                } catch (e) {
                    return false
                }
            },
        })
    }
</script>
