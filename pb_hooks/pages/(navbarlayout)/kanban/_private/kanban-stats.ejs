<!-- Kanban Quick Stats Cards Component -->
<div
    class="mb-6 grid grid-cols-2 gap-3 sm:gap-4"
    :class="(sortedStages.length + 2) <= 4 ? 'sm:grid-cols-4' : ((sortedStages.length + 2) <= 6 ? 'sm:grid-cols-3 lg:grid-cols-6' : 'sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-6')"
>
    <!-- Overall Total Tasks -->
    <div
        class="rounded-xl border border-base-300 bg-base-200/50 p-3.5 backdrop-blur-sm sm:p-4"
    >
        <div class="text-xs font-medium text-base-content/60">Total Tasks</div>
        <div class="mt-1 flex items-baseline gap-2">
            <span
                class="text-2xl font-black text-base-content"
                x-text="todos.length"
                >0</span
            >
            <span class="text-xs text-base-content/40">items</span>
        </div>
    </div>

    <!-- Dynamic Stage Totals -->
    <template x-for="st in sortedStages" :key="st.id || st.key">
        <div
            class="rounded-xl border p-3.5 backdrop-blur-sm transition-all duration-200 sm:p-4"
            :class="stageCardClass(st.color)"
        >
            <div
                class="flex items-center gap-1.5 text-xs font-medium truncate"
                :class="stageTextClass(st.color)"
                :title="st.name"
            >
                <span
                    class="h-2 w-2 rounded-full inline-block shrink-0"
                    :class="colorDotClass(st.color)"
                ></span>
                <span class="truncate" x-text="st.name">Stage</span>
            </div>
            <div class="mt-1 flex items-baseline gap-2">
                <span
                    class="text-2xl font-black"
                    :class="stageTextClass(st.color)"
                    x-text="getCardsByStatus(st.key).length"
                    >0</span
                >
                <span
                    class="text-xs"
                    :class="stageSubtextClass(st.color)"
                    x-text="todos.length ? Math.round((getCardsByStatus(st.key).length / todos.length) * 100) + '%' : '0%'"
                    >0%</span
                >
            </div>
        </div>
    </template>

    <!-- Subtasks Progress -->
    <div
        class="rounded-xl border border-info/30 bg-info/5 p-3.5 backdrop-blur-sm sm:p-4"
    >
        <div class="text-xs font-medium text-info">Subtasks Progress</div>
        <div class="mt-1 flex items-baseline gap-2">
            <span
                class="text-2xl font-black text-info"
                x-text="completedSubtasksCount + '/' + totalSubtasksCount"
                >0/0</span
            >
            <span
                class="text-xs text-info/60"
                x-text="totalSubtasksCount ? Math.round((completedSubtasksCount / totalSubtasksCount) * 100) + '%' : '0%'"
                >0%</span
            >
        </div>
    </div>
</div>

