<!-- Quick Stats Cards Component -->
<div
    class="mb-6 grid grid-cols-2 gap-3 sm:gap-4 md:flex md:flex-wrap md:items-stretch lg:flex-nowrap lg:gap-4"
>
    <!-- Combined Total Tasks & Subtasks -->
    <div
        class="rounded-xl border border-base-300 bg-base-200/50 p-3.5 backdrop-blur-sm sm:p-4 md:flex-1 md:min-w-[150px]"
    >
        <div
            class="flex items-center justify-between text-xs font-medium text-base-content/60"
        >
            <span>Total Tasks</span>
            <span
                class="text-xs font-semibold text-info"
                x-text="totalSubtasksCount ? (completedSubtasksCount + '/' + totalSubtasksCount + ' subs') : '0 subs'"
                >0/0 subs</span
            >
        </div>
        <div class="mt-1 flex items-baseline justify-between">
            <div class="flex items-baseline gap-2">
                <span
                    class="text-2xl font-black text-base-content"
                    x-text="todos.length"
                    >0</span
                >
                <span class="text-xs text-base-content/40">items</span>
            </div>
            <span
                class="text-xs font-medium text-info/70"
                x-text="totalSubtasksCount ? Math.round((completedSubtasksCount / totalSubtasksCount) * 100) + '%' : '0%'"
                >0%</span
            >
        </div>
    </div>

    <!-- Dynamic Stage Totals -->
    <template x-for="st in sortedStages" :key="st.id || st.key">
        <div
            class="rounded-xl border p-3.5 backdrop-blur-sm transition-all duration-200 sm:p-4 md:flex-1 md:min-w-[140px]"
            :class="stageCardClass(st.color)"
        >
            <div
                class="flex items-center gap-1.5 text-xs font-medium truncate"
                :class="stageTextClass(st.color)"
                :title="st.name"
            >
                <span
                    class="h-2 w-2 rounded-full inline-block shrink-0"
                    :class="colorDotClass(st.color)"
                ></span>
                <span class="truncate" x-text="st.name">Stage</span>
            </div>
            <div class="mt-1 flex items-baseline gap-2">
                <span
                    class="text-2xl font-black"
                    :class="stageTextClass(st.color)"
                    x-text="getCardsByStatus(st.key).length"
                    >0</span
                >
                <span
                    class="text-xs"
                    :class="stageSubtextClass(st.color)"
                    x-text="todos.length ? Math.round((getCardsByStatus(st.key).length / todos.length) * 100) + '%' : '0%'"
                    >0%</span
                >
            </div>
        </div>
    </template>
</div>

