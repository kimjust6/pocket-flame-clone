<!-- Reusable Task Card Component -->
<div
    draggable="true"
    @dragstart="onDragStart($event, task)"
    @dragend="onDragEnd()"
    class="group relative flex cursor-grab flex-col rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md active:cursor-grabbing"
    :class="{
        'opacity-40 scale-95': draggedTaskId === task.id,
        'border-l-4 border-l-error': task.priority === 'urgent',
        'border-l-4 border-l-warning': task.priority === 'high',
        'border-l-4 border-l-info': task.priority === 'medium',
        'border-l-4 border-l-success': task.priority === 'low'
    }"
>
    <!-- Card Top Bar: Priority Badge + Action Buttons -->
    <div class="mb-2 flex items-center justify-between">
        <span
            class="inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider"
            :class="priorityBadgeClass(task.priority)"
            x-text="priorityLabel(task.priority)"
        ></span>

        <div
            class="flex items-center gap-1 opacity-0 transition-opacity group-hover:opacity-100"
        >
            <button
                @click.stop="openTaskModal(task)"
                class="btn btn-square btn-ghost btn-xs h-6 w-6"
                title="Edit Task & Subtasks"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-3.5 w-3.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                    />
                </svg>
            </button>
            <button
                @click.stop="deleteTask(task.id)"
                class="btn btn-square btn-ghost btn-xs h-6 w-6 text-error hover:bg-error/10"
                title="Delete Task"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-3.5 w-3.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                    />
                </svg>
            </button>
        </div>
    </div>

    <!-- Card Title -->
    <h3
        @click="openTaskModal(task)"
        class="cursor-pointer text-sm font-semibold leading-snug text-base-content transition-colors hover:text-primary"
        :class="task.status === 'done' ? 'line-through opacity-70' : ''"
        x-text="task.title"
    ></h3>

    <!-- Card Description (if present) -->
    <p
        x-show="task.description"
        class="mt-1.5 line-clamp-2 text-xs text-base-content/60"
        x-text="task.description"
    ></p>

    <!-- SUBTASKS SECTION ON CARD -->
    <div
        x-show="task.subtasks && task.subtasks.length > 0"
        class="mt-3 rounded-lg border border-base-300/80 bg-base-200/50 p-2.5"
    >
        <!-- Subtask Header Progress -->
        <div
            class="flex items-center justify-between text-[11px] font-medium text-base-content/70"
        >
            <span class="flex items-center gap-1">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-3 w-3 text-primary"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
                    />
                </svg>
                Subtasks
            </span>
            <span
                x-text="countCompletedSubtasks(task) + '/' + task.subtasks.length"
            ></span>
        </div>

        <!-- Mini Progress Bar -->
        <div
            class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-base-300"
        >
            <div
                class="h-full bg-primary transition-all duration-300"
                :style="`width: ${task.subtasks.length ? Math.round((countCompletedSubtasks(task) / task.subtasks.length) * 100) : 0}%`"
            ></div>
        </div>

        <!-- Subtasks Interactive Checklist -->
        <div class="mt-2 space-y-1.5">
            <template
                x-for="(sub, sIdx) in task.subtasks"
                :key="sub.id || sIdx"
            >
                <label
                    class="flex cursor-pointer items-center gap-2 text-xs text-base-content/80 transition-colors hover:text-base-content"
                    @click.stop
                >
                    <input
                        type="checkbox"
                        :checked="sub.completed"
                        @change="toggleCardSubtask(task, sub.id)"
                        class="checkbox-primary checkbox checkbox-xs rounded"
                    />
                    <span
                        class="select-none text-[11px] leading-tight"
                        :class="sub.completed ? 'line-through opacity-50' : ''"
                        x-text="sub.title"
                    ></span>
                </label>
            </template>
        </div>
    </div>

    <!-- Tags Pills -->
    <div x-show="task.tags" class="mt-2.5 flex flex-wrap gap-1">
        <template x-for="tag in parseTags(task.tags)" :key="tag">
            <span
                class="rounded bg-base-300/60 px-1.5 py-0.5 text-[10px] font-medium text-base-content/75"
                x-text="'#' + tag"
            ></span>
        </template>
    </div>

    <!-- Card Footer: Due Date & Column Move Chevrons -->
    <div
        class="mt-3 flex items-center justify-between border-t border-base-300/50 pt-2 text-xs"
    >
        <div class="flex items-center gap-1.5 text-[11px] text-base-content/50">
            <template x-if="task.due_date">
                <div
                    class="flex items-center gap-1 font-medium"
                    :class="isOverdue(task.due_date) && task.status !== 'done' ? 'text-error font-semibold' : ''"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-3 w-3"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                        />
                    </svg>
                    <span x-text="formatDate(task.due_date)"></span>
                    <span
                        x-show="isOverdue(task.due_date) && task.status !== 'done'"
                        class="badge badge-error badge-xs font-bold"
                        >Overdue</span
                    >
                </div>
            </template>
        </div>

        <!-- Quick Move Column Chevrons -->
        <div class="flex items-center gap-1">
            <button
                x-show="canMoveLeft(task.status)"
                @click.stop="moveTaskStep(task, -1)"
                class="btn btn-ghost btn-xs h-5 w-5 p-0 text-base-content/40 hover:text-base-content"
                title="Move to previous stage"
            >
                ←
            </button>
            <button
                x-show="canMoveRight(task.status)"
                @click.stop="moveTaskStep(task, 1)"
                class="btn btn-ghost btn-xs h-5 w-5 p-0 text-base-content/40 hover:text-base-content"
                title="Move to next stage"
            >
                →
            </button>
        </div>
    </div>
</div>
